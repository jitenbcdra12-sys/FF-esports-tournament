rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "jitenbcdra12@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User validation
    function isValidUser(data) {
      return data.id is string &&
        data.email is string &&
        data.role in ['player', 'admin'];
    }

    // Match validation
    function isValidMatch(data) {
      return data.title is string &&
        data.mode in ['br', 'cs', 'lonewolf'] &&
        data.entryFee is number &&
        data.capacity is number &&
        data.status in ['upcoming', 'open', 'room_ready', 'live', 'completed', 'cancelled_refunded'];
    }

    // Transactions validation
    function isValidTransaction(data) {
      return data.userId is string &&
        data.type in ['deposit', 'withdrawal', 'entry_fee', 'kill_bounty', 'win_prize', 'auto_refund', 'signup_bonus'] &&
        data.amount is number &&
        data.status in ['completed', 'pending', 'failed'];
    }

    // Rules for Users collection
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && isValidUser(incoming());
      allow delete: if isAdmin();
    }

    // Rules for Matches collection
    match /matches/{matchId} {
      allow read: if true; // Public tournament schedule & open slots
      allow create, delete: if isAdmin() && isValidId(matchId);
      allow update: if (
        isAdmin() ||
        (isSignedIn() && isValidMatch(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['registeredPlayers']))
      );
    }

    // Rules for Transactions collection
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || isAdmin()) && isValidTransaction(incoming());
      allow update, delete: if isAdmin();
    }

    // Rules for Notifications collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        !('userId' in existing()) ||
        existing().userId == request.auth.uid ||
        existing().userId == '' ||
        isAdmin()
      );
      allow create: if isAdmin() || (isSignedIn() && incoming().userId == request.auth.uid);
      allow update: if isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      allow delete: if isAdmin();
    }

    // Admin role bootstrap doc check
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
